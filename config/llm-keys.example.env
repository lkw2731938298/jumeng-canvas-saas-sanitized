# =============================================================================
# 大模型 API 密钥模板（画布系统统一配置）
# =============================================================================
# 1. 复制本文件为同目录下的 llm-keys.env（仅本地开发可选）
# 2. 生产环境：密钥只在管理后台「供应商密钥」加密写入 MySQL，勿把真实 Key 放进本文件
# 3. 部署会上传本模板（空 Key）到 ECS；llm-keys.env 已被 .gitignore 忽略
# =============================================================================

# ---------- 豆包文本 (Volcengine Ark Chat) ----------
DOUBAO_API_KEY=
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# 文本推理接入点（ep-xxxxxxxx）或模型 ID 二选一
# 豆包 Pro 用 Endpoint；Seed 2.1 Pro / Seed Evolving 用模型 ID（Evolving 固定 doubao-seed-evolving，勿加日期后缀）
DOUBAO_ENDPOINT_ID=
# DOUBAO_TEXT_MODEL=doubao-pro-32k-240615
# 兼容主平台变量名
# DOUBAO_SUBJECT_EXTRACT_MODEL=ep-xxxxxxxx
# DOUBAO_CHAT_MODEL=

# ---------- 方舟图片 + Seedance 视频（可与 DOUBAO_API_KEY 相同或分离）----------
ARK_API_KEY=
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_IMAGE_MODEL=
DOUBAO_IMAGE_ENDPOINT_ID=
ARK_SEEDANCE_20_MODEL_ID=
ARK_SEEDANCE_20_FAST_MODEL_ID=
ARK_SEEDANCE_15_PRO_I2V_MODEL_ID=

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---------- 阿里云百炼 DashScope（万相 / HappyHorse / PixVerse / CosyVoice）----------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ---------- 可灵（可选独立百炼 Key，未填则回退 DASHSCOPE_API_KEY）----------
# KLING_DASHSCOPE_API_KEY=

# ---------- Vidu 企业版（参考生 / 首尾帧 / 对口型）----------
VIDU_API_KEY=
VIDU_API_BASE=https://api.vidu.cn

# ---------- RunningHub CN 站（MJ 文生图等）----------
RUNNINGHUB_API_KEY=
RUNNINGHUB_API_BASE=https://www.runninghub.cn
# ---------- RunningHub 海外版 / AI 站（全能图片 Pro/G、LTX、音乐；LLM 走 llm.runninghub.ai）----------
# LTX_I2V_RUNNINGHUB_API_KEY=
RUNNINGHUB_OVERSEAS_API_BASE=https://www.runninghub.ai

# ---------- NodyHub（图片：香蕉 Pro / GPT Img2 / SD2.0）----------
NODYHUB_API_KEY=
NODYHUB_API_BASE=https://nodyhub.com/v1

# ---------- 华狐 AI（Seedance 2.0 · Ark 兼容网关）----------
HUAHU_API_KEY=
HUAHU_API_BASE=https://api.example.com/v1

# ---------- 聚梦 AI 网关（OpenAI 兼容 /v1/videos · 去字幕精准版）----------
JUMENGAI_API_KEY=
JUMENGAI_API_BASE=https://api.example.com/v1

# ---------- 预留：OpenAI 兼容 / 通义千问 Chat / 智谱 / Moonshot ----------
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
ZHIPU_API_KEY=
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
MOONSHOT_API_KEY=
MOONSHOT_API_BASE=https://api.moonshot.cn/v1

# ---------- 本地 OpenAI 兼容（Ollama / vLLM / SGLang）----------
# Key 可填占位 local；Docker 内 API 访问宿主机请用 host.docker.internal
LOCAL_API_KEY=local
LOCAL_API_BASE=http://127.0.0.1:8000/v1

# 自定义密钥文件路径（可选）
# LLM_KEYS_FILE=
