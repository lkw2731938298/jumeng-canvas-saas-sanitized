# 支付宝正式环境配置示例（复制到 /etc/jumeng-canvas/api.env 或 packages/api/.env）
# 切勿将真实私钥提交到 Git

ALIPAY_MODE=live
ALIPAY_APP_ID=your_app_id
ALIPAY_PRIVATE_KEY=your_app_private_key_base64_or_pem
ALIPAY_PUBLIC_KEY=alipay_platform_public_key_base64_or_pem
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 须经 nginx 精确 location 直连画布 API（见 nginx-c-apex-locations.conf），勿落到 Next /api
# Host 用用户站 www.example.com；路径勿含 admin；勿挂到管理独立域
ALIPAY_NOTIFY_URL=https://www.example.com/api/v1/payments/alipay-notify

# 架构：用户侧加算力仅支付宝扫码（§8.12 验签+查单）；管理后台可调账。
# 已永久关闭无支付直连 POST /credits/recharge，勿再配置 CREDITS_DIRECT_RECHARGE_ENABLED。
# 对用户文案仅提示「请使用支付宝扫码充值」，不暴露管理员加款。
