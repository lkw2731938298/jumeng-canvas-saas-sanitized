# 开源副本本地 / Compose 示例（复制为 .env 后自行修改，勿提交 .env）

CANVAS_STORAGE_LOCAL_ONLY=true
STORAGE_URL_MODE=proxy
AI_MOCK_ENABLED=true
ADMIN_AUTH_DISABLED=true
SMS_FORCE_LOCAL_DEBUG=true
SMS_DEBUG_RETURN_CODE=true
REGISTRATION_ENABLED=true
CREDITS_ENABLED=true
DEFAULT_USER_CREDITS=0

# 首次启动写入内置管理员 13800000000；请改成自己的口令
DEV_ADMIN_PASSWORD=change-me-admin

# 必须固定，不要每次启动随机生成
JWT_SECRET=replace-me-with-a-long-random-string
CANVAS_SESSION_SECRET=replace-me-with-a-long-random-string

API_WORKERS=1

# 画布 Docker 访问宿主机上的本地推理（Ollama / vLLM / SGLang / ComfyUI）
LOCAL_API_KEY=local
LOCAL_API_BASE=http://host.docker.internal:8000/v1
LOCAL_MODEL_ROOT=
