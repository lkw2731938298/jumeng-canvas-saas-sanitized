# 复制为 env.sh 后填写真实值（env.sh 已 gitignore，勿提交真实密钥）
# 本文件为开源占位模板，不含任何真实主机/口令/密钥

export API_HOST="YOUR_API_HOST"
export API_SSH_USER="ecs-user"
export API_SSH_PORT="22"

export WORKER_HOST="YOUR_WORKER_HOST"
export WORKER_SSH_USER="ecs-user"
export WORKER_SSH_PORT="22"

export REMOTE_DIR="/opt/jumeng-canvas"
export REMOTE_PYTHON_BIN="python3.12"

export MYSQL_HOST="127.0.0.1"
export MYSQL_PORT="3306"
export MYSQL_DATABASE="jumeng_canvas"
export MYSQL_USER="jumeng_canvas"
export MYSQL_PASSWORD='YOUR_MYSQL_PASSWORD'

export REDIS_HOST="127.0.0.1"
export REDIS_PORT="6379"
export REDIS_USER=""
export REDIS_PASSWORD='YOUR_REDIS_PASSWORD'
export REDIS_DB="1"
export REDIS_USE_TLS="false"

export OSS_ENDPOINT="oss-cn-hangzhou-internal.aliyuncs.com"
export OSS_BUCKET="YOUR_OSS_BUCKET"
export OSS_ACCESS_KEY_ID=""
export OSS_ACCESS_KEY_SECRET=""
export OSS_OBJECT_PREFIX="Ihuabu"
export STORAGE_URL_MODE="cdn"
export OSS_CDN_BASE_URL="https://cdn.example.com"

# 会话密钥：本地/各环境写死固定长串；禁止部署时随机生成
export JWT_SECRET=""
export CANVAS_SESSION_SECRET=""
export CREDENTIAL_ENCRYPTION_KEY=""

export CANVAS_PUBLIC_ORIGIN="https://www.example.com"
export CANVAS_WEB_BASE_PATH=""
export CANVAS_WEB_C_PORT="3002"
export BASE_PATH="/canvas"
export ALIPAY_NOTIFY_URL="https://www.example.com/api/v1/payments/alipay-notify"
export CANVAS_ADMIN_ORIGIN="https://admin.example.com"

export MODEL_CONCURRENCY_IMAGE="4"
export MODEL_CONCURRENCY_VIDEO="2"
export MODEL_CONCURRENCY_TEXT="4"
export MODEL_CONCURRENCY_AUDIO="2"
export WORKER_PARALLELISM_IMAGE="4"
export WORKER_PARALLELISM_VIDEO="2"
export WORKER_PARALLELISM_TEXT="4"
export WORKER_PARALLELISM_AUDIO="2"

export SSH_PASSWORD="YOUR_SSH_PASSWORD"
export API_SSH_PASSWORD="${SSH_PASSWORD}"
export WORKER_SSH_PASSWORD="${SSH_PASSWORD}"

export ALIBABA_CLOUD_ACCESS_KEY_ID=""
export ALIBABA_CLOUD_ACCESS_KEY_SECRET=""
export ALIBABA_CLOUD_REGION_ID="cn-hangzhou"
export SMS_SIGN_NAME=""
export SMS_TEMPLATE_CODE=""

export ALIPAY_MODE="live"
export ALIPAY_APP_ID=""
export ALIPAY_PRIVATE_KEY=""
export ALIPAY_PUBLIC_KEY=""
export ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
