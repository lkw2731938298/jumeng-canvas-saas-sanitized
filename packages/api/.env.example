# 画布平台环境变量
# 部署到服务器时通过 docker-compose 传入，或创建 .env 文件

# 数据库
DATABASE_URL=mysql+aiomysql://jumeng_canvas:change-me@127.0.0.1:3306/jumeng_canvas
REDIS_URL=redis://redis:6380/0

# JWT / 会话（方案 B：HMAC userId|phone|exp|sig，legacy JWT 仍兼容至过期）
# 必须写死固定值，禁止每次启动/部署随机生成（否则已登录用户全部失效）
JWT_SECRET=
# CANVAS_SESSION_SECRET=          # 留空则复用 JWT_SECRET
# CANVAS_SESSION_TTL_SECONDS=2592000
# LOGIN_MAX_FAILURES=6
# LOGIN_LOCK_SECONDS=1200

# 短信验证（开发可设 SMS_FORCE_LOCAL_DEBUG=true；生产对接阿里云见下方）
REGISTRATION_ENABLED=true
SMS_REGISTRATION_REQUIRED=true
SMS_SEND_COOLDOWN_SECONDS=60
SMS_CODE_TTL_SECONDS=300
SMS_DEBUG_RETURN_CODE=true
SMS_FORCE_LOCAL_DEBUG=true
SMS_FALLBACK_ON_PROVIDER_ERROR=true
# 生产：与主平台共用阿里云短信签名/模板时填写以下变量，并设 SMS_FORCE_LOCAL_DEBUG=false、SMS_DEBUG_RETURN_CODE=false
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# ALIBABA_CLOUD_REGION_ID=cn-hangzhou
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
# SMS_TEMPLATE_PARAM_KEY=code

# 内置管理员（手机 13800000000）首次启动时写入密码，仅当尚无 password_hash 时生效
DEV_ADMIN_PASSWORD=

# 主站 SSO（可选，算力不再依赖主站网关）
MAIN_SITE_API_URL=https://legacy-v.example.com
MAIN_SITE_INTERNAL_TOKEN=

# 本系统独立算力
CREDITS_ENABLED=true
DEFAULT_USER_CREDITS=0

# ComfyUI GPU 推理服务
COMFYUI_BASE_URL=

# 本地 OpenAI 兼容推理（Ollama / vLLM / SGLang）；权重由推理服务自行读取
LOCAL_API_BASE=http://127.0.0.1:8000/v1
LOCAL_MODEL_ROOT=

# 阿里云 OSS — 文本/图片/视频/音频/节点工作流统一存储
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=YOUR_OSS_BUCKET
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_OBJECT_PREFIX=Ihuabu

# 大模型 API 密钥 — 单独存放在项目根目录 config/llm-keys.env
# 复制 config/llm-keys.example.env → config/llm-keys.env 后填入
